# Server Configuration
PORT=5000
NODE_ENV=production
API_VERSION=v1

# Frontend URLs (Update with your Vercel deployment URLs)
FRONTEND_URL=https://your-frontend.vercel.app
ADMIN_URL=https://your-admin.vercel.app

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_this_in_production
JWT_REFRESH_EXPIRE=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=your-email@gmail.com

# Upload Configuration
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880
PUBLIC_UPLOAD_URL=https://your-backend.onrender.com/uploads

# OTP Configuration
OTP_LENGTH=6

# Fixed OTP for Development (DISABLE IN PRODUCTION)
AUTH_FIXED_OTP_ENABLED=false
AUTH_FIXED_OTP_CODE=

# Admin Configuration
ADMIN_EMAILS=admin@example.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Security Configuration
CSRF_SECRET=your_super_secure_csrf_secret_random_string
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
